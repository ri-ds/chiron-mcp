# Where Chiron lives. Auto-discovered if is4r-chiron sits next to this project,
# or if `chiron` is pip-installed into the venv. Set it when neither is true.
#CHIRON_MCP_CHIRON_SRC=/path/to/is4r-chiron
#CHIRON_MCP_PROJECT_DIR=/path/to/is4r-chiron/test_project
#CHIRON_MCP_BASE_SETTINGS=project.settings

# The two databases. Leave unset to inherit whatever the host project's settings say.
# Set them to point at a specific deployment's metadata and warehouse.
#CHIRON_MCP_METADATA_DB=/path/to/chiron_metadata.sqlite3
#CHIRON_MCP_WAREHOUSE_URL=postgresql://user:pass@host:5432/chiron

# REQUIRED. The Django user the server acts as. No default, and no autocreate:
# this user needs a ChironUser row per dataset (see scripts/grant_access.py).
CHIRON_MCP_USERNAME=

# Safety. phi is opt-in; the ceiling clamps whatever the ChironUser actually has.
CHIRON_MCP_MAX_ACCESS_LEVEL=deid
#CHIRON_MCP_DATASETS=synthea-10k,synthea-small
#CHIRON_MCP_OPERATOR=1
#CHIRON_MCP_ALLOW_SAVE=1
#CHIRON_MCP_MAX_EXPORT_ROWS=50000

# Transport. stdio (default) is launched by the MCP client. http serves the same tools
# at http://127.0.0.1:<port>/mcp, loopback only, with no authentication.
#CHIRON_MCP_TRANSPORT=http
#CHIRON_MCP_HTTP_PORT=8765
# oauth: callers of the HTTP endpoint sign in as a Chiron user and act as that user.
# CHIRON_MCP_USERNAME is then not needed. The signing key is generated on first use.
#CHIRON_MCP_HTTP_AUTH=oauth
#CHIRON_MCP_OAUTH_SECRET=
