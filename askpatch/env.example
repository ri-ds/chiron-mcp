# Ask as an add-on for an existing Chiron. Copy to .env and fill in; then:
#   docker compose up -d --build        (the Ask container)
#   add the /ask route to the web server   (proxy/)
#   turn the tab on in the UI               (README.md, "The Ask tab")
#   python3 check.py
# Paths are on this machine. Secrets stay in this file: keep it mode 600 and out of git.

# --- the Chiron this Ask is added to --------------------------------------------------
# The Chiron checkout: the directory holding chiron/ and requirements/. The image is
# built from it, so Ask runs the deployment's own Chiron code.
CHIRON_SRC=/srv/chiron/is4r-chiron
# The Django project (the directory holding manage.py), mounted read-only: its settings
# module and custom processors are what Ask runs with. CHIRON_SETTINGS names the settings
# module if it is not project.settings.
CHIRON_PROJECT_DIR=/srv/chiron/is4r-chiron/test_project
#CHIRON_SETTINGS=project.settings

# The two databases, as the CONTAINER reaches them: a Postgres on this machine is
# host.docker.internal, not localhost. The metadata database must be Postgres (SQLite
# file locks do not cross the container boundary); the warehouse is whatever
# CHIRON_SQL_ALCHEMY_CONNECTION_STRING says, written for the container.
CHIRON_MCP_METADATA_DB=postgresql://chiron:secret@host.docker.internal:5432/chiron_meta
CHIRON_MCP_WAREHOUSE_URL=postgresql://chiron:secret@host.docker.internal:5432/chiron

# --- the site -------------------------------------------------------------------------
# Where people open Chiron, with the path prefix if it has one (https://example.org/chiron).
# The web server serves /ask on this same address, which is how Ask knows who is logged in.
PUBLIC_URL=https://chiron.example.org
# The port (and address) the web server forwards /ask to. This machine only by default.
#ASK_BIND=127.0.0.1:8900

# --- what Ask may see -----------------------------------------------------------------
# The access ceiling: whatever the logged-in person has in Chiron, capped here
# (agg, deid or phi). Questions and their figures go to the model's provider.
CHIRON_MCP_MAX_ACCESS_LEVEL=deid
#CHIRON_MCP_THREAD_TTL_HOURS=12
#CHIRON_MCP_TURN_SECONDS=240

# --- the models -----------------------------------------------------------------------
# The models the page may switch between, as ids with labels (Haiku is the default when
# listed, else Opus, else the first). Unset: the model Claude Code is set to, no menu.
#CHIRON_MCP_ASK_MODELS=us.anthropic.claude-opus-5-5=Opus 5.5,us.anthropic.claude-sonnet-5-5=Sonnet 5.5,us.anthropic.claude-haiku-5-5=Haiku 5.5
# Which backend answers:
#  * a Claude account: leave these unset and log the container in once, yourself:
#      docker compose exec -it ask claude     (then /login, then /exit)
#  * Amazon Bedrock: the three lines below, and credentials from the machine's role or
#    from an AWS profile (compose.aws.yml).
#CLAUDE_CODE_USE_BEDROCK=1
#AWS_REGION=us-east-1
#AWS_PROFILE=
#ANTHROPIC_MODEL=us.anthropic.claude-haiku-5-5
# Claude Code's own extras, off in a server
DISABLE_AUTOUPDATER=1
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# --- build ----------------------------------------------------------------------------
#CLAUDE_CODE_VERSION=2.1.283
# 0 lets the deployment's own version pins win over chiron-mcp's constraints.txt
#USE_CONSTRAINTS=1
# a Postgres on macOS needs 0 here (see chiron_mcp/django_settings.py)
#CHIRON_MCP_PG_CHECK_INTERVAL=2000

# --- check.py -------------------------------------------------------------------------
# a Chiron account with access to a dataset, for the end-to-end check (no password: the
# check makes a session inside the container)
#ASK_CHECK_USER=demouser
#ASK_CHECK_DATASET=
