# syntax=docker/dockerfile:1
#
# The front door: Caddy serving the built Chiron UI (with the Ask tab) and routing
# everything else to the chiron and ask services. Build context is the repository root.

FROM node:22-bookworm-slim AS ui
WORKDIR /ui
COPY vendor/is4r-chiron-ui/package.json vendor/is4r-chiron-ui/package-lock.json ./
# --legacy-peer-deps: the UI pins eslint 9 while eslint-config-react-app wants eslint 8,
# a lint-only conflict that does not affect the built app.
RUN npm ci --legacy-peer-deps --no-audit --no-fund
COPY vendor/is4r-chiron-ui/ ./
# The Ask tab embeds the Ask server from the same origin, which is what lets it read
# the Chiron login. VITE_MUI_KEY is optional (an MUI X licence key, if you have one).
ARG VITE_MUI_KEY=""
ENV VITE_ASK_URL=/ask \
    VITE_MUI_KEY=${VITE_MUI_KEY}
RUN npm run build

FROM caddy:2-alpine
COPY --from=ui /ui/dist /srv/ui
COPY deploy/Caddyfile /etc/caddy/Caddyfile
