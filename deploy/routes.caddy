# The site's routes, shared by Caddyfile (served at the root) and Caddyfile.subpath
# (served under BASE_PATH, which strips the prefix before these run). Paths here are
# therefore always the unprefixed ones; {http.request.orig_uri.path} is the one the
# browser actually asked for.

# The Ask server, on the same origin as Chiron so it can read the Chiron login.
redir /ask {http.request.orig_uri.path}/ 308
handle_path /ask/* {
	reverse_proxy ask:8900 {
		# answers stream as server-sent events; pass each one on at once
		flush_interval -1
	}
}

# Django's own static files (admin, login page), collected into a shared volume.
handle /static/* {
	root * /srv
	file_server
}

# Everything Chiron's Django serves for the UI.
@django path /api/* /accounts/* /admin/* /backend/* /ajax/*
handle @django {
	reverse_proxy chiron:8000
}

# The MCP endpoint (/mcp) and its OAuth sign-in (/mcp/authorize, /mcp/token,
# /mcp/register, /mcp/oauth/login, ...), served by the optional `mcp` container
# (compose profile "mcp"; see deploy/README.md). Without it these answer 502.
handle /mcp {
	reverse_proxy mcp:8765
}
handle_path /mcp/* {
	reverse_proxy mcp:8765
}

# The React UI; client-side routes fall back to index.html.
handle {
	root * /srv/ui
	try_files {path} /index.html
	file_server
}
